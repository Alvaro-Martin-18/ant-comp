# prosapia configuration — fill in the values for the tools you use. You only
# need the values for the tools you actually run.
#
# `sapia init --config` writes this file (as `.env`) alongside an `activation/`
# dir of per-tool templates.
#
# Each tool's site-specific setup — activation AND that tool's own paths — lives in
# a per-tool *activation script*, not here (templates in the scaffolded activation/). This
# file only holds:
#   • global settings,
#   • the SAPIA_ACTIVATE_<NAME> pointer to each tool's activation script, and
#   • the few values prosapia reads at submit time, before any activation script runs
#     (called out per tool below).
#
# See docs/configuration.md for the full reference.

# ── Tool discovery ───────────────────────────────────────────────────────────
# Extra directories to load custom tools from (os.pathsep-separated).
# PROSAPIA_TOOLS_DIR="/shared/lab/prosapia-tools:./tools"

# ── Executor ────────────────────────────────────────────────────────────────
# Default scheduler for `sapia run` (override per run with --executor): slurm | modal.
# SAPIA_EXECUTOR="slurm"

# ── Modal (only for --executor modal; needs `prosapia[modal]`) ──────────────────
# Runs live on this Modal Volume, mounted at /runs in the workstation
# (`sapia modal-shell`) and in every task container. Your run_dirs must be under it.
SAPIA_MODAL_RUNS_VOLUME="sapia-runs"
# Workstation size
# SAPIA_MODAL_SHELL_CPU="0.25"
# SAPIA_MODAL_SHELL_MEMORY="1024"
# Per-tool volumes for weights/databases/caches (defaults in each tool's modal_image.py):
SAPIA_MODAL_VOLUME_RFD3_CKPT="rfd3-checkpoints"
SAPIA_MODAL_VOLUME_BOLTZ_CACHE="boltz-cache"
# BindCraft2's AlphaFold parameters (~5.3 GB), downloaded on first campaign.
SAPIA_MODAL_VOLUME_BINDCRAFT_CACHE="bindcraft-cache"
# SAPIA_MODAL_VOLUME_COLABFOLD_DATA="sapia-colabfold-data"
# SAPIA_MODAL_AF3_IMAGE="registry.example.org/you/alphafold3:latest"
# SAPIA_MODAL_VOLUME_AF3_PARAMS="sapia-af3-params"
# SAPIA_MODAL_VOLUME_AF3_DB="sapia-af3-db"

# ── Conda base (for general activation scripts) ────────────────────────────────────────────
# Used by activation scripts that source "$CONDA_PREFIX/etc/profile.d/conda.sh".
# CONDA_PREFIX="/path/to/miniconda3"

# ── SLURM Activation scripts ─────────────────────────────────────────────────────────────
# Each tool's .sh task script sources SAPIA_ACTIVATE_<NAME> before running its command
# (skipped under --executor modal, where the tool's Modal image provides the environment).
# Edit the matching template in the scaffolded activation/ dir, then point the variable here at it.

# RFdiffusion (rfdiffusion) — activates SE3nv (run_inference.py on PATH); RUN_INFERENCE/RFDIFFUSION_PYTHON optional.
# SAPIA_ACTIVATE_RFDIFFUSION="/shared/lab/activation/rfdiffusion.sh"

# RFdiffusion3 (rfdiffusion3) — activation + FOUNDRY_CHECKPOINT_DIRS.
# SAPIA_ACTIVATE_RFDIFFUSION3="/shared/lab/activation/rfdiffusion3.sh"
# Submit-time (stays here): explicit checkpoint override. Optional — foundry
# auto-discovers checkpoints after `foundry install rfd3`.
# RFD3_CKPT=""

# ProteinMPNN (proteinmpnn) — exports PROTEIN_MPNN (+ optional PROTEIN_MPNN_PYTHON).
# SAPIA_ACTIVATE_PROTEINMPNN="/shared/lab/activation/proteinmpnn.sh"

# AlphaFold3 (alphafold3) — exports AF3_CONTAINER / AF3_PARAMETERS / AF3_DATABASE.
# SAPIA_ACTIVATE_ALPHAFOLD3="/shared/lab/activation/alphafold3.sh"

# ColabFold (colabfold) — puts colabfold_batch on PATH.
# SAPIA_ACTIVATE_COLABFOLD="/shared/lab/activation/colabfold.sh"

# OpenFold3 (openfold3) — puts run_openfold on PATH.
# SAPIA_ACTIVATE_OPENFOLD3="/shared/lab/activation/openfold3.sh"

# Boltz (boltz) — puts boltz on PATH.
# SAPIA_ACTIVATE_BOLTZ="/shared/lab/activation/boltz.sh"

# BindCraft2 (bindcraft2) — puts `bindcraft` on PATH (or exports BINDCRAFT_BIN).
# Off a shared cache, also export BINDCRAFT_AF2_PARAMS or let ~/.cache/bindcraft fill.
# SAPIA_ACTIVATE_BINDCRAFT2="/shared/lab/activation/bindcraft2.sh"

# USalign (USalign) — puts USalign on PATH (or exports USALIGN_BIN).
# SAPIA_ACTIVATE_USALIGN="/shared/lab/activation/usalign.sh"

# Rosetta relax (relaxed) & make_symmdef (symmdef) — export ROSETTA.
# One script serves both; point both variables at it.
# SAPIA_ACTIVATE_RELAXED="/shared/lab/activation/rosetta.sh"
# SAPIA_ACTIVATE_SYMMDEF="/shared/lab/activation/rosetta.sh"

# Pure-Python tools (align_symm_axis, …) — activates an env with prosapia + gemmi +
# numpy (or exports PIPELINE_PYTHON). One script serves them all; point each at it.
# SAPIA_ACTIVATE_ALIGN_SYMM_AXIS="/shared/lab/activation/python.sh"

# ── vib HPC workstation (for the vib-orchestrator agent; read locally, NOT by prosapia) ──
# The HPC counterpart of the Modal workstation. Two directories, deliberately separate:
#
#   SAPIA_VIB_ENV_DIR      where prosapia lives and where every sapia command is run from.
#                          Holds .venv/, the vib-side .env (SAPIA_EXECUTOR=slurm) and
#                          activation/. **The agent always cds here**: a SLURM task starts
#                          in the submit dir, and its prelude sources ./.env from there —
#                          and those SAPIA_ACTIVATE_* paths are relative to this dir.
#   SAPIA_VIB_PROJECT_DIR  where the run_dirs and all outputs go. Point this wherever you
#                          want the data; it needs no prosapia install. The agent passes
#                          run_dirs as absolute paths under it, so they resolve from any
#                          compute node regardless of cwd.
#
SAPIA_VIB_HOST="vib"
SAPIA_VIB_ENV_DIR="/data/groups/csb/anastassia.vorobieva/envs/prosapia-workstation-dev"
SAPIA_VIB_PROJECT_DIR=""
# Command that puts `sapia` on PATH; run after cd-ing into SAPIA_VIB_ENV_DIR.
SAPIA_VIB_ACTIVATE="source .venv/bin/activate"
# Your SLURM account, passed as `sapia run -a <account>`. **Required on vib** — every
# `sapia run` must carry it, and prosapia omits --account entirely when it is unset.
# Personal, like SAPIA_VIB_PROJECT_DIR: ships blank, set your own and don't commit it.
SAPIA_VIB_ACCOUNT=""
